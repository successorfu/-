/* ============================================================
   诊断域页面样式
   通用样式（card / cell / tag / badge / btn / progress / kv / dose
   / cal / receipt / timeline / chips / note-bar）全部来自 app.wxss
   这里只补本页独有的结构
   ============================================================ */

/* ---------- 部位选择（P10） ---------- */
.parts {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}
.part {
  width: 48%;
  margin: 0 4% 10px 0;
  padding: 15px 14px;
  text-align: center;
  box-sizing: border-box;
  border: 1.5px solid transparent;
  transition: border-color 0.15s ease;
}
.part:nth-child(2n) {
  margin-right: 0;
}
.part-on {
  border: 1.5px solid var(--brand);
}
.part-icon {
  font-size: 24px;
  line-height: 1.4;
}
.part-name {
  font-size: 15px;
  margin-top: 6px;
}

/* ---------- 相机取景（P11） ---------- */
.cam {
  background: #0d1215;
  min-height: 100vh;
  padding: 12px 16px 20px;
  box-sizing: border-box;
}
.vf {
  position: relative;
  width: 100%;
  height: 390px;
  border-radius: 16px;
  overflow: hidden;
  background: #111;
}
.vf-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: radial-gradient(circle at 32% 38%, #6c8a8d, #3d5a5d 45%, #22383a);
}
.vf-frame {
  position: absolute;
  left: 14%;
  right: 14%;
  top: 22%;
  bottom: 30%;
  border: 2px dashed rgba(255, 255, 255, 0.75);
  border-radius: 12px;
}
.vf-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: #1D9A6C;
  color: #fff;
  font-size: 11px;
  padding: 4px 10px;
  border-radius: 999px;
}
.vf-hint {
  position: absolute;
  left: 12px;
  right: 12px;
  bottom: 12px;
  background: rgba(0, 0, 0, 0.62);
  color: #fff;
  font-size: 12.5px;
  line-height: 1.55;
  padding: 10px 12px;
  border-radius: 10px;
}
.vf-hint .hl {
  color: #FFD08A;
  font-weight: 700;
}
.shots {
  display: flex;
  flex-direction: row;
  margin-top: 12px;
}
.shot {
  flex: 1;
  height: 60px;
  line-height: 60px;
  text-align: center;
  font-size: 11px;
  color: #4b6165;
  border: 1px dashed #3a5054;
  border-radius: 12px;
  margin-right: 8px;
}
.shot:last-child {
  margin-right: 0;
}
.shot-on {
  background: #1c282b;
  border: 1px solid #2c3d41;
  color: #7fd1d9;
}
.cam-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 22px;
}
.cam-txt {
  color: #8b9a9d;
  font-size: 14px;
}
.cam-txt.on {
  color: #7fd1d9;
}
.shutter {
  width: 68px;
  height: 68px;
  border-radius: 50%;
  border: 3px solid rgba(255, 255, 255, 0.85);
  display: flex;
  align-items: center;
  justify-content: center;
}
.shutter-in {
  width: 54px;
  height: 54px;
  border-radius: 50%;
  background: #fff;
}

/* ---------- 结果态头部（P12 / P23） ---------- */
.center-head {
  padding: 30px 20px 0;
  text-align: center;
}
.round {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  line-height: 72px;
  font-size: 32px;
  margin: 0 auto;
  text-align: center;
}
.round-err {
  background: var(--error-50);
  color: var(--error);
}
.round-warn {
  background: #FFF3D9;
  font-size: 30px;
}
.head-t {
  font-size: 19px;
  margin-top: 16px;
}
.head-s {
  margin-top: 8px;
}
.blur-box {
  height: 160px;
  border-radius: 12px;
  background: linear-gradient(160deg, #4a5f61, #2c3c3e);
  color: rgba(255, 255, 255, 0.5);
  font-size: 12px;
  letter-spacing: 2px;
  text-align: center;
  line-height: 160px;
}

/* ---------- 诊断详情（P30） ---------- */
.lesion-fish {
  position: absolute;
  left: 24%;
  top: 34%;
  width: 52%;
  height: 38%;
  border-radius: 50% 45% 45% 50%;
  background: radial-gradient(circle, #C9705F, #8AA6A7 72%);
  opacity: 0.9;
}
.thumb-muted {
  opacity: 0.4;
}
.muted-t {
  color: var(--ink-3);
}
.conf {
  width: 56px;
  margin-left: 6px;
  flex: none;
}
.bar.muted {
  background: #D3DDDC;
}
.reason {
  display: block;
}
.reason-i {
  margin-right: 4px;
}
.txt-ok {
  color: var(--success);
}
.txt-bad {
  color: var(--error);
}
.card-hi {
  border: 1.5px solid var(--brand);
}
.quote {
  background: #F5F8F7;
  padding: 13px;
  border-radius: 12px;
  font-size: 13.5px;
  line-height: 1.9;
  color: var(--ink-2);
}

/* ---------- 相似病例（P31） ---------- */
.card-hero {
  background: linear-gradient(168deg, #0D8189 0%, #0B6E75 46%, #07585E 100%);
  color: #fff;
}
.hero-sub {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
}
.hero-num {
  font-size: 22px;
  font-weight: 600;
  margin-top: 6px;
  letter-spacing: -0.3px;
}
.hero-num2 {
  font-size: 18px;
  font-weight: 600;
  margin-top: 6px;
}
.hero-rate {
  font-size: 34px;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.38);
  font-variant-numeric: tabular-nums;
}
.hero-days {
  text-align: right;
}
.hero-days .n {
  font-size: 30px;
  font-weight: 600;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}
.hero-days .u {
  font-size: 11px;
  color: rgba(255, 255, 255, 0.8);
}

/* ---------- 补证据（P22） ---------- */
.gain {
  color: var(--success);
  font-weight: 600;
}

/* ---------- 方案页（P40） ---------- */
.tabs {
  background: var(--surface);
  display: flex;
  flex-direction: row;
  border-bottom: 1px solid var(--line);
}
.tab-item {
  flex: 1;
  text-align: center;
  padding: 14px 0;
  font-size: 14px;
  color: var(--ink-3);
}
.tab-item.on {
  color: var(--brand);
  font-weight: 600;
  border-bottom: 2px solid var(--brand);
}

/* ---------- 日历（P43） ---------- */
.legend .li {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.dot-mk {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  background: var(--brand);
  margin-right: 5px;
}
.dot-hollow {
  width: 10px;
  height: 10px;
  border-radius: 3px;
  border: 1.5px solid var(--brand);
  margin-right: 5px;
}

/* ---------- 用药单（P44） ---------- */
.qr-tip {
  text-align: center;
  font-size: 10.5px;
  color: var(--ink-3);
}

/* ---------- 通用小工具 ---------- */
.strong {
  font-weight: 600;
}
.f1 {
  flex: 1;
}
.mr10 {
  margin-right: 10px;
}
.emo {
  font-size: 20px;
  margin-right: 10px;
}
.kv.last {
  border-bottom: none;
}
